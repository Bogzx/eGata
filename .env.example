# =============================================================================
# eGata — the one canonical environment example.
#
#   cp .env.example .env
#
# docker compose reads this file automatically. Everything below has a working
# default in docker-compose.yml, so `docker compose up --build` works with no
# .env at all — copy it only when you want to change something or plug in
# Azure keys for the chat.
#
# Running the backend outside Docker? Copy this to backend/.env too; the
# variable names are identical (backend/app/config.py).
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# Compose brings up Postgres+pgvector with these credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=egata
DB_PORT=5432

# Only needed when running the backend outside Docker, or when pointing it at
# a Supabase project instead of the compose database.
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/egata

# -----------------------------------------------------------------------------
# PDF storage
# -----------------------------------------------------------------------------

# local    — PDFs on a Docker volume, served by /files/pdf with short-lived
#            HMAC-signed links. No Supabase project needed. This is the default.
# supabase — Supabase Storage in a PRIVATE bucket, links via create_signed_url.
#            Requires SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY below.
# auto     — supabase if a project is configured, otherwise local.
STORAGE_BACKEND=local

# Only for STORAGE_BACKEND=supabase. Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Agent backend
# -----------------------------------------------------------------------------

# Which agent answers the chat.
# auto    — the Azure OpenAI LLM when AZURE_OPENAI_API_KEY is set, otherwise
#           the offline agent. This is the default.
# offline — backend/app/offline_agent.py: a deterministic script (keyword
#           search, then field-by-field questions). No key, no cost, no AI.
#           Same tools, state machine, PDF and ledger as the LLM path.
# azure   — always the LLM (fails without a key).
AGENT_BACKEND=auto

# Procedure-search embeddings: auto | local (offline, lexical) | azure.
# Both indexes can exist side by side; the one in use is searched.
EMBEDDINGS_BACKEND=auto

# -----------------------------------------------------------------------------
# LLM agent — the only part of the stack that needs a paid API key
# -----------------------------------------------------------------------------
# Without these, everything still works and the offline agent answers the
# chat (AGENT_BACKEND above). Search only uses vectors built by the current
# embedder (migrations/012), but two Azure deployments are not told apart:
# re-index after changing AZURE_OPENAI_EMBED_DEPLOYMENT.
#
# After setting these, build the index:
#   docker compose run --rm migrate python -m scripts.index_rag

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_API_VERSION=2024-10-21

# -----------------------------------------------------------------------------
# Voice — optional, browser voice WS + Twilio phone bridge
# -----------------------------------------------------------------------------
AZURE_VOICELIVE_ENDPOINT=
AZURE_VOICELIVE_API_KEY=
AZURE_VOICELIVE_MODEL=gpt-realtime
AZURE_VOICELIVE_VOICE=en-US-Ava:DragonHDLatestNeural
AZURE_VOICELIVE_API_VERSION=2026-04-10
# One of: whisper-1, gpt-4o-transcribe, gpt-4o-mini-transcribe,
# gpt-4o-transcribe-diarize, azure-fast-transcription, azure-speech,
# mai-transcribe-1. NOT an Azure deployment name — a fixed enum the realtime
# API maps internally. whisper-1 emits only one final COMPLETED event;
# gpt-4o-mini-transcribe streams DELTA events so the user's bubble fills
# word-by-word as they speak.
AZURE_VOICELIVE_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AZURE_VOICELIVE_TRANSCRIPTION_LANGUAGE=ro

# -----------------------------------------------------------------------------
# Auth
# -----------------------------------------------------------------------------

# MOCK_OTP=1 skips Twilio and accepts the literal code 123456 for any persona.
# That is an auth bypass, so it is OFF by default in code — compose turns it on
# for the demo stack explicitly. NEVER set it on anything real.
MOCK_OTP=1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_PHONE_NUMBER=
# Phone bridge (optional). The webhook checks X-Twilio-Signature with
# TWILIO_AUTH_TOKEN and refuses to hand out the stream URL without it; the
# stream then needs the per-call token the webhook put in the TwiML.
# TWILIO_BRIDGE_PUBLIC_URL=wss://<public-host>/voice/twilio
# Exact webhook URL configured in the Twilio console — needed behind a tunnel
# or proxy, where the URL the app sees is not the one Twilio signed.
# TWILIO_WEBHOOK_PUBLIC_URL=https://<public-host>/voice/twilio/webhook

# Generate with `openssl rand -hex 32`. Also signs local PDF download links.
JWT_SIGNING_SECRET=dev-only-not-a-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_SECONDS=86400

# POST /demo/reset returns 401 unless this is set and matches the X-Demo-Token
# header. Leave empty to keep the endpoint disabled.
DEMO_RESET_TOKEN=

# -----------------------------------------------------------------------------
# Networking
# -----------------------------------------------------------------------------

# Comma-separated CORS allow list. Must include the origin the browser uses.
ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host port mappings. Change if 3000/8000 are taken.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# The browser-visible backend URL. Used by the frontend AND to build signed
# PDF links, so it must be reachable from the browser, not from inside the
# compose network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# 1 shows the persona dropdown on the login screen.
NEXT_PUBLIC_DEMO_MODE=1

# 1 serves the frontend from MSW mocks with no backend. Note that the mocks do
# NOT cover /agent/chat/stream, so the chat does not work in this mode.
NEXT_PUBLIC_USE_MOCKS=0

LOG_LEVEL=info
# CNPs, e-mails and phone numbers are masked in logs; 0 shows them (local debugging only).
LOG_REDACT_PII=1
