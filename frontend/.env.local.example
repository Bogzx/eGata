NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=1
# MSW mocks only cover the legacy REST surface. The new state-machine
# endpoints (/agent/chat/stream, /agent/widget-result, /scenarios/*) fall
# through with onUnhandledRequest=warn and hit the real backend with mock
# JWTs the backend rejects. Default to the real backend; set to 1 only if
# you've added the missing handlers in mocks/handlers.ts.
NEXT_PUBLIC_USE_MOCKS=0
