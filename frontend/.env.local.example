NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=1
NEXT_PUBLIC_USE_MOCKS=1
# Set to "1" to route voice through the backend /agent/voice/ws bridge
# (recommended; keeps the Gemini API key server-side). Default 0 falls
# back to the legacy browser-direct WS in frontend/lib/gemini-live.ts.
NEXT_PUBLIC_VOICE_BRIDGE=0
