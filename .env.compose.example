# =============================================================================
# docker-compose overrides (root).
#
# Most secrets live in backend/.env (Supabase URL/keys, Gemini key, JWT secret,
# etc.) — compose reads that file directly via `env_file:`. Only put values
# here if you want to override the docker-compose defaults below.
# Copy to `.env` next to docker-compose.yml.
# =============================================================================

# Browser-visible API URL. Defaults to http://localhost:8000 (host-mapped
# backend port). Change if you're publishing the stack behind a different host
# or port — must be reachable from the user's browser, not from inside the
# compose network.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Show the persona dropdown on the login screen. 1 = demo mode on.
NEXT_PUBLIC_DEMO_MODE=1

# Use MSW client-side mocks instead of hitting the backend. Leave 0 for the
# real stack.
NEXT_PUBLIC_USE_MOCKS=0

# Host-side port mapping. Change if 3000/8000 are already taken (e.g. another
# dev server is running). Container-internal ports stay 3000 / 8000.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Note: ALLOW_ORIGINS lives in backend/.env — it's read straight from there
# via env_file. Edit it in backend/.env if you map FRONTEND_PORT to a value
# the existing list doesn't cover.
